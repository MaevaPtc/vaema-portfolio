---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { title = 'Maëva PETIT — Book' } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo-vaema.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600;700&family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500&family=Space+Mono:ital,wght@0,400;0,700&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <div id="curseur" transition:persist></div>
  </body>
</html>

<style is:global>
  * { cursor: none !important; }

  #curseur {
    position: fixed;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #8C2D3F;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: background 0.15s, transform 0.15s;
  }

  #curseur.jaune { background: #D4993A; transform: translate(-50%, -50%) scale(1.4); }

  @media (max-width: 768px) {
    * { cursor: auto !important; }
    #curseur { display: none; }
  }
</style>

<script is:inline>
  function initCurseur() {
    var curseur = document.getElementById('curseur');
    if (!curseur) return;

    document.addEventListener('mousemove', function(e) {
      curseur.style.left = e.clientX + 'px';
      curseur.style.top  = e.clientY + 'px';
    });

    function bindHover() {
      document.querySelectorAll('nav, .section-outline, .section-num, .cat, .outil-label, .contact-label, #btn-top, .bandeau, a, button').forEach(function(el) {
        el.addEventListener('mouseenter', function() { curseur.classList.add('jaune'); });
        el.addEventListener('mouseleave', function() { curseur.classList.remove('jaune'); });
      });
    }

    bindHover();
    document.addEventListener('astro:page-load', bindHover);
  }

  initCurseur();
  document.addEventListener('astro:page-load', initCurseur);
</script>
