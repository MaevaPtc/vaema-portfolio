---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Floyd — VAEMA">

  <nav>
    <a href="/home" class="nav-logo"><img src="/logo-vaema.svg" alt="VAEMA" /></a>
    <button class="nav-burger" id="navBurger"><span></span><span></span><span></span></button>
    <ul id="navMenu">
      <li><a href="/home#projets" data-i18n="nav.projects">Tracklist</a></li>
      <li><a href="/home#l-artiste" data-i18n="nav.about">Crédits</a></li>
      <li><a href="/home#on-se-capte" data-i18n="nav.contact">Booking</a></li>
      <li><button id="langToggle" class="nav-fr">FR</button></li>
    </ul>
  </nav>

  <div class="scroll-layout">
    <aside class="scroll-aside">
      <div class="aside-inner">
        <div class="aside-meta">
          <span class="projet-cat" data-i18n="cat.campaign">Campagne 360</span>
          <span class="projet-annee">2025</span>
        </div>
        <h1 class="aside-titre">FLOYD</h1>
        <p class="aside-tagline" data-i18n="floyd.tagline">Exprimez votre style</p>
        <div class="aside-brief">
          <p data-i18n="floyd.desc">Avec Floyd, changez vos roues, vos couleurs, votre mood et voyagez à votre image. La campagne invite à exprimer son style jusque dans les moindres détails.</p>
          <div class="catalog-card">
            <div class="catalog-header">CATALOG</div>
            <div class="catalog-field"><span class="catalog-label">Artist</span><span class="catalog-val">Maëva PETIT</span></div>
            <div class="catalog-field"><span class="catalog-label">Genre</span><span class="catalog-val">Campagne 360</span></div>
            <div class="catalog-field"><span class="catalog-label">Release</span><span class="catalog-val">2025</span></div>
            <div class="catalog-field"><span class="catalog-label">Format</span><span class="catalog-val">Print · Digital</span></div>
          </div>
        </div>
        <div class="aside-progress"><div class="progress-bar" id="progressBar"></div></div>
      </div>
    </aside>

    <main class="scroll-main">
      <div class="visuel-block reveal" data-label="AFFICHES — 01">
        <img src="/projects/Floyd/michele-mouton.png" alt="Floyd — Michèle Mouton" />
      </div>
      <div class="visuel-block reveal" data-label="AFFICHES — 02">
        <img src="/projects/Floyd/Tommy Smith.png" alt="Floyd — Tommy Smith" />
      </div>
      <div class="visuel-block reveal" data-label="AFFICHES — 03">
        <img src="/projects/Floyd/Ann Meyers NBA.png" alt="Floyd — Ann Meyers" />
      </div>
      <div class="visuel-block reveal" data-label="MOCKUPS — 01">
        <img src="/projects/Floyd/mockup affiche tommie.png" alt="Floyd — Mockup Tommie" />
      </div>
      <div class="visuel-block reveal" data-label="MOCKUPS — 02">
        <img src="/projects/Floyd/mockup affiche ann.png" alt="Floyd — Mockup Ann" />
      </div>
      <div class="visuel-block reveal" data-label="MOCKUPS — 03">
        <img src="/projects/Floyd/mockup affiche .png" alt="Floyd — Mockup" />
      </div>
      <div class="visuel-block reveal" data-label="STREET MARKETING — 01">
        <img src="/projects/Floyd/street-marketing tommie smith.png" alt="Floyd — Street Tommie" />
      </div>
      <div class="visuel-block reveal" data-label="STREET MARKETING — 02">
        <img src="/projects/Floyd/street-marketing ann meyers.png" alt="Floyd — Street Ann" />
      </div>
      <div class="visuel-block reveal" data-label="STREET MARKETING — 03">
        <img src="/projects/Floyd/street-marketing michele mouton.png" alt="Floyd — Street Michèle" />
      </div>
    </main>
  </div>

  <div class="projet-nav">
    <a href="/portfolio/duralex" class="projet-nav-retour">← Duralex</a>
    <a href="/portfolio/after-all-fest" class="projet-nav-suivant">After All Fest →</a>
  </div>

</Layout>

<style is:global>
  .scroll-layout { display: grid; grid-template-columns: 38% 62%; min-height: 100vh; padding-top: 132px; }
  .scroll-aside { position: sticky; top: 132px; height: calc(100vh - 132px); border-right: 1px solid rgba(212,153,58,0.25); overflow: hidden; }
  .aside-inner { height: 100%; padding: 3rem 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .aside-meta { display: flex; gap: 1.2rem; align-items: center; }
  .projet-cat { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.3em; text-transform: uppercase; color: #8C2D3F; border: 1px solid #8C2D3F; padding: 0.3rem 0.8rem; }
  .projet-annee { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.3em; color: rgba(255,255,255,0.25); }
  .aside-titre { font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 7vw, 8rem); line-height: 0.85; color: #F2E4C4; letter-spacing: 0.02em; }
  .aside-tagline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.5rem, 2.5vw, 3rem); -webkit-text-stroke: 1.5px #D4993A; color: transparent; letter-spacing: 0.05em; }
  .aside-brief { flex: 1; display: flex; flex-direction: column; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); }
  .aside-brief p { font-family: 'Space Grotesk', sans-serif; font-size: 0.82rem; line-height: 1.8; color: rgba(242,228,196,0.5); }
  .aside-infos { display: flex; flex-direction: column; gap: 1rem; }
  .aside-info-bloc { display: flex; flex-direction: column; gap: 0.3rem; }
  .aside-info-label { font-family: 'Space Mono', monospace; font-size: 0.48rem; letter-spacing: 0.3em; text-transform: uppercase; color: #8C2D3F; }
  .aside-info-val { font-family: 'Space Grotesk', sans-serif; font-size: 0.78rem; color: rgba(242,228,196,0.6); line-height: 1.5; }
  .scroll-main { padding: 4rem 3rem 6rem; display: flex; flex-direction: column; gap: 6rem; }
  .visuel-block { position: relative; }
  .visuel-block::before { content: attr(data-label); position: absolute; top: -1.5rem; left: 0; font-family: 'Space Mono', monospace; font-size: 0.5rem; letter-spacing: 0.4em; color: #D4993A; }
  .visuel-block img { width: 100%; height: auto; display: block; }
  .reveal { opacity: 0; transform: translateY(50px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  @media (max-width: 768px) {
    .scroll-layout { grid-template-columns: 1fr; }
    .scroll-aside { position: static; height: auto; border-right: none; border-bottom: 1px solid rgba(212,153,58,0.25); }
    .aside-inner { padding: 2rem 1.2rem; }
    .scroll-main { padding: 2rem 1.2rem 4rem; gap: 3rem; }
    .aside-progress { display: none; }
  }
</style>

<script is:inline>
  var translations = {
    fr: { 'nav.projects': 'Projets', 'nav.about': 'À propos', 'nav.contact': 'Contact', 'cat.campaign': 'Campagne 360', 'floyd.tagline': 'Exprimez votre style', 'floyd.desc': 'Avec Floyd, changez vos roues, vos couleurs, votre mood et voyagez à votre image. La campagne invite à exprimer son style jusque dans les moindres détails.', 'brief.target': 'Cible', 'brief.insight': 'Insight', 'brief.supports': 'Supports', 'floyd.target': '25–45 ans · Voyageurs urbains, créatifs et indépendants', 'floyd.insight': 'Ils privilégient les marques à forte identité visuelle et à dimension émotionnelle', 'floyd.supports': 'Affichage · Street marketing · Motion' },
    en: { 'nav.projects': 'Projects', 'nav.about': 'About', 'nav.contact': 'Contact', 'cat.campaign': '360 Campaign', 'floyd.tagline': 'Express your style', 'floyd.desc': 'With Floyd, change your wheels, your colours, your mood and travel in your own image. The campaign invites you to express your style down to the smallest detail.', 'brief.target': 'Target', 'brief.insight': 'Insight', 'brief.supports': 'Supports', 'floyd.target': '25–45 · Urban travellers, creative and independent', 'floyd.insight': 'They favour brands with a strong visual identity and emotional dimension', 'floyd.supports': 'Advertising · Street marketing · Motion' }
  };
  function applyLang(lang) { document.querySelectorAll('[data-i18n]').forEach(function(el) { var k = el.getAttribute('data-i18n'); if (translations[lang][k]) el.textContent = translations[lang][k]; }); var t = document.getElementById('langToggle'); if (t) t.textContent = lang === 'fr' ? 'EN' : 'FR'; localStorage.setItem('vaema-lang', lang); }
  var currentLang = localStorage.getItem('vaema-lang') || 'fr';
  if (currentLang === 'en') applyLang('en');
  var toggle = document.getElementById('langToggle');
  if (toggle) { toggle.textContent = currentLang === 'fr' ? 'EN' : 'FR'; toggle.addEventListener('click', function() { currentLang = currentLang === 'fr' ? 'en' : 'fr'; applyLang(currentLang); }); }
</script>
<script is:inline>
  // Burger géré dans Layout.astro
  function initReveal() {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(function(el) { obs.observe(el); });
  }
  initReveal();
  document.addEventListener('astro:page-load', initReveal);
  var progressBar = document.getElementById('progressBar'); var scrollMain = document.querySelector('.scroll-main');
  function updateProgress() { if (!progressBar || !scrollMain) return; var rect = scrollMain.getBoundingClientRect(); var pct = Math.max(0, Math.min(100, (-rect.top / (scrollMain.offsetHeight - window.innerHeight)) * 100)); progressBar.style.width = pct + '%'; }
  window.addEventListener('scroll', updateProgress, { passive: true }); updateProgress();
</script>






