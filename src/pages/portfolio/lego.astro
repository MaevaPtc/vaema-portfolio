---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="LEGO — Rêvez Autrement · VAEMA">

  <!-- NAV -->
  <nav>
    <a href="/home" class="nav-logo"><img src="/logo-vaema.svg" alt="VAEMA" /></a>
    <button class="nav-burger" id="navBurger"><span></span><span></span><span></span></button>
    <ul id="navMenu">
      <li><a href="/home#projets" data-i18n="nav.projects">Projets</a></li>
      <li><a href="/home#l-artiste" data-i18n="nav.about">À propos</a></li>
      <li><a href="/home#on-se-capte" data-i18n="nav.contact">Contact</a></li>
      <li><button id="langToggle" class="nav-fr">FR</button></li>
    </ul>
  </nav>

  <!-- SCROLLYTELLING -->
  <div class="scroll-layout">

    <!-- COLONNE GAUCHE STICKY -->
    <aside class="scroll-aside">
      <div class="aside-inner">
        <div class="aside-meta">
          <span class="projet-cat" data-i18n="cat.display">Affichage</span>
          <span class="projet-annee">2026</span>
        </div>
        <h1 class="aside-titre">LEGO</h1>
        <p class="aside-tagline" data-i18n="lego.tagline">Rêvez Autrement</p>

        <div class="aside-brief">
          <p data-i18n="lego.desc">Dans un monde dominé par les écrans et l'intelligence artificielle, la créativité devient souvent instantanée et passive. Cette campagne repositionne LEGO comme un outil de créativité libre et physique.</p>
          <div class="catalog-card">
            <div class="catalog-header">CATALOG</div>
            <div class="catalog-field"><span class="catalog-label">Artist</span><span class="catalog-val">Maëva PETIT</span></div>
            <div class="catalog-field"><span class="catalog-label">Genre</span><span class="catalog-val">Publicité</span></div>
            <div class="catalog-field"><span class="catalog-label">Release</span><span class="catalog-val">2026</span></div>
            <div class="catalog-field"><span class="catalog-label">Format</span><span class="catalog-val">Print</span></div>
          </div>
        </div>

        <div class="aside-progress">
          <div class="progress-bar" id="progressBar"></div>
        </div>
      </div>
    </aside>

    <!-- COLONNE DROITE : VISUELS -->
    <main class="scroll-main">

      <div class="visuel-block reveal" data-label="01">
        <img src="/projects/lego/lego-yacht.JPG" alt="LEGO Rêvez Autrement — Yacht" />
      </div>

      <div class="visuel-block reveal" data-label="02">
        <img src="/projects/lego/lego-chien.JPG" alt="LEGO Rêvez Autrement — Chien" />
      </div>

    </main>

  </div>

  <!-- NAVIGATION PROJETS -->
  <div class="projet-nav">
    <a href="/home#projets" class="projet-nav-retour" data-i18n="nav.allprojects">← Tous les projets</a>
    <a href="/portfolio/sea-shepherd" class="projet-nav-suivant">Sea Shepherd →</a>
  </div>

</Layout>

<style is:global>

  nav:not(.projet-nav) { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2.5rem; background: rgba(14,9,6,0.9); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .nav-logo img { height: 36px; width: auto; display: block; filter: brightness(0) invert(1); }
  nav ul { display: flex; gap: 2.5rem; list-style: none; }
  nav ul a { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.55); transition: color 0.2s; }
  nav ul a:hover { color: #D4993A; }
  .nav-fr { background: none; border: none; border-bottom: 1px solid #8C2D3F; padding-bottom: 2px; color: #F2E4C4; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; transition: color 0.2s; }
  .nav-fr:hover { color: #D4993A; }

  /* ── LAYOUT ── */
  .scroll-layout {
    display: grid;
    grid-template-columns: 38% 62%;
    min-height: 100vh;
    padding-top: 132px;
  }

  /* ── ASIDE STICKY ── */
  .scroll-aside {
    position: sticky;
    top: 132px;
    height: calc(100vh - 132px);
    border-right: 1px solid rgba(212,153,58,0.25);
    overflow: hidden;
  }

  .aside-inner {
    height: 100%;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .aside-meta {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .projet-cat {
    font-family: 'Space Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8C2D3F;
    border: 1px solid #8C2D3F;
    padding: 0.3rem 0.8rem;
  }

  .projet-annee {
    font-family: 'Space Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    color: rgba(255,255,255,0.25);
  }

  .aside-titre {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 7vw, 8rem);
    line-height: 0.85;
    color: #F2E4C4;
    letter-spacing: 0.02em;
  }

  .aside-tagline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 3rem);
    -webkit-text-stroke: 1.5px #D4993A;
    color: transparent;
    letter-spacing: 0.05em;
  }

  .aside-brief {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .aside-brief p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.82rem;
    line-height: 1.8;
    color: rgba(242,228,196,0.5);
  }

  .aside-infos {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .aside-info-bloc {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .aside-info-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.48rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8C2D3F;
  }

  .aside-info-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.78rem;
    color: rgba(242,228,196,0.6);
    line-height: 1.5;
  }

  /* Barre de progression */

  /* ── VISUELS ── */
  .scroll-main {
    padding: 4rem 3rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .visuel-block {
    position: relative;
  }

  .visuel-block::before {
    content: attr(data-label);
    position: absolute;
    top: -1.5rem;
    left: 0;
    font-family: 'Space Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.4em;
    color: #D4993A;
  }

  .visuel-block img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Animation reveal au scroll */
  .reveal {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── NAV PROJETS ── */
  .projet-nav { display: flex; justify-content: space-between; position: fixed; top: 72px; left: 0; right: 0; z-index: 999; background: #8C2D3F; padding: 14px 2.5rem; }
  .projet-nav-retour, .projet-nav-suivant { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.9); transition: color 0.2s; }
  .projet-nav-retour:hover, .projet-nav-suivant:hover { color: #D4993A; }

  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; padding: 0.5rem; z-index: 200; }
  .nav-burger span { display: block; width: 24px; height: 2px; background: #fff; transition: all 0.3s; }
  .nav-burger.ouvert span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.ouvert span:nth-child(2) { opacity: 0; }
  .nav-burger.ouvert span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 768px) {
    .scroll-layout { grid-template-columns: 1fr; }
    .scroll-aside { position: static; height: auto; border-right: none; border-bottom: 1px solid rgba(212,153,58,0.25); }
    .aside-inner { padding: 2rem 1.2rem; }
    .scroll-main { padding: 2rem 1.2rem 4rem; gap: 3rem; }
    .aside-progress { display: none; }
    nav:not(.projet-nav) { padding: 1.2rem 1.5rem; background: #0E0906; }
    .nav-burger { display: flex; }
    nav ul { display: flex; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #0E0906; flex-direction: column; align-items: center; justify-content: center; gap: 3rem; z-index: 150; transform: translateX(100%); transition: transform 0.4s ease; }
    nav ul.ouvert { transform: translateX(0); }
    nav ul a { font-size: 1rem; letter-spacing: 0.3em; }
    .projet-nav { top: 72px; }
  }

</style>

<script is:inline>
  // Traductions
  var translations = {
    fr: {
      'nav.projects': 'Projets', 'nav.about': 'À propos', 'nav.contact': 'Contact',
      'nav.allprojects': '← Tous les projets',
      'cat.display': 'Affichage',
      'lego.tagline': 'Rêvez Autrement',
      'lego.desc': "Dans un monde dominé par les écrans et l'intelligence artificielle, la créativité devient souvent instantanée et passive. Cette campagne repositionne LEGO comme un outil de créativité libre et physique.",
      'brief.target': 'Cible', 'brief.supports': 'Supports', 'brief.goal': 'Objectif',
      'lego.target': '15–30 ans · Gen Z & jeunes millennials',
      'lego.supports': 'Affichage urbain · Print',
      'lego.goal': "Moderniser l'image LEGO · Rendre la marque désirable au-delà de l'enfance",
    },
    en: {
      'nav.projects': 'Projects', 'nav.about': 'About', 'nav.contact': 'Contact',
      'nav.allprojects': '← All projects',
      'cat.display': 'Advertising',
      'lego.tagline': 'Dream Differently',
      'lego.desc': 'In a world dominated by screens and AI, creativity has often become instant and passive. This campaign repositions LEGO as a tool for free, physical creativity.',
      'brief.target': 'Target', 'brief.supports': 'Supports', 'brief.goal': 'Goal',
      'lego.target': '15–30 · Gen Z & young millennials',
      'lego.supports': 'Urban advertising · Print',
      'lego.goal': "Modernize LEGO's image · Make the brand desirable beyond childhood",
    }
  };

  function applyLang(lang) {
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n');
      if (translations[lang] && translations[lang][key]) el.textContent = translations[lang][key];
    });
    var toggle = document.getElementById('langToggle');
    if (toggle) toggle.textContent = lang === 'fr' ? 'EN' : 'FR';
    localStorage.setItem('vaema-lang', lang);
  }

  var currentLang = localStorage.getItem('vaema-lang') || 'fr';
  if (currentLang === 'en') applyLang('en');

  var toggle = document.getElementById('langToggle');
  if (toggle) {
    toggle.textContent = currentLang === 'fr' ? 'EN' : 'FR';
    toggle.addEventListener('click', function() {
      currentLang = currentLang === 'fr' ? 'en' : 'fr';
      applyLang(currentLang);
    });
  }
</script>

<script is:inline>
  // Burger géré dans Layout.astro

  // Reveal au scroll (IntersectionObserver)
  function initReveal() {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(function(el) { obs.observe(el); });
  }
  initReveal();
  document.addEventListener('astro:page-load', initReveal);

  // Barre de progression
  var progressBar = document.getElementById('progressBar');
  var scrollMain  = document.querySelector('.scroll-main');

  function updateProgress() {
    if (!progressBar || !scrollMain) return;
    var rect     = scrollMain.getBoundingClientRect();
    var total    = scrollMain.offsetHeight - window.innerHeight;
    var scrolled = -rect.top;
    var pct      = Math.max(0, Math.min(100, (scrolled / total) * 100));
    progressBar.style.width = pct + '%';
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>




