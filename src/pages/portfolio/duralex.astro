---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Duralex — VAEMA">

  <nav>
    <a href="/home" class="nav-logo"><img src="/logo-vaema.svg" alt="VAEMA" /></a>
    <button class="nav-burger" id="navBurger"><span></span><span></span><span></span></button>
    <ul id="navMenu">
      <li><a href="/home#projets" data-i18n="nav.projects">Projets</a></li>
      <li><a href="/home#l-artiste" data-i18n="nav.about">À propos</a></li>
      <li><a href="/home#on-se-capte" data-i18n="nav.contact">Contact</a></li>
      <li><button id="langToggle" class="nav-fr">FR</button></li>
    </ul>
  </nav>

  <div class="scroll-layout">
    <aside class="scroll-aside">
      <div class="aside-inner">
        <div class="aside-meta">
          <span class="projet-cat" data-i18n="cat.campaign">Campagne 360</span>
          <span class="projet-annee">2026</span>
        </div>
        <h1 class="aside-titre">DURALEX</h1>
        <p class="aside-tagline" data-i18n="duralex.tagline">On fait tous pareil</p>
        <div class="aside-brief">
          <p data-i18n="duralex.desc">Rachetée par ses salariés après liquidation judiciaire, Duralex renait en coopérative. Cette campagne mobilise le grand public pour soutenir ce modèle porté par les travailleurs eux-mêmes.</p>
          <div class="aside-infos">
            <div class="aside-info-bloc">
              <span class="aside-info-label" data-i18n="brief.goal">Objectif</span>
              <span class="aside-info-val" data-i18n="duralex.goal">Sensibiliser · Inciter aux dons pour la SCOP</span>
            </div>
            <div class="aside-info-bloc">
              <span class="aside-info-label" data-i18n="brief.target">Cible</span>
              <span class="aside-info-val" data-i18n="duralex.target">Grand public · Consommateurs engagés · Nostalgiques</span>
            </div>
            <div class="aside-info-bloc">
              <span class="aside-info-label" data-i18n="brief.supports">Supports</span>
              <span class="aside-info-val" data-i18n="duralex.supports">Affichage · Réseaux sociaux</span>
            </div>
          </div>
        </div>
        <div class="aside-progress"><div class="progress-bar" id="progressBar"></div></div>
      </div>
    </aside>

    <main class="scroll-main">
      <div class="visuel-block reveal" data-label="AFFICHES — 01">
        <img src="/projects/duralex/affiche-1.PNG" alt="Duralex — Affiche 1" />
      </div>
      <div class="visuel-block reveal" data-label="AFFICHES — 02">
        <img src="/projects/duralex/affiche-2.PNG" alt="Duralex — Affiche 2" />
      </div>
      <div class="visuel-block reveal" data-label="AFFICHES — 03">
        <img src="/projects/duralex/affiche-3.PNG" alt="Duralex — Affiche 3" />
      </div>
      <div class="visuel-block reveal" data-label="RÉSEAUX SOCIAUX">
        <img src="/projects/duralex/rs.PNG" alt="Duralex — Réseaux sociaux" />
      </div>
    </main>
  </div>

  <div class="projet-nav">
    <a href="/portfolio/sea-shepherd" class="projet-nav-retour">← Sea Shepherd</a>
    <a href="/portfolio/floyd" class="projet-nav-suivant">Floyd →</a>
  </div>

</Layout>

<style is:global>
  nav:not(.projet-nav) { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2.5rem; background: rgba(14,9,6,0.9); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .nav-logo img { height: 36px; width: auto; display: block; filter: brightness(0) invert(1); }
  nav ul { display: flex; gap: 2.5rem; list-style: none; }
  nav ul a { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.55); transition: color 0.2s; }
  nav ul a:hover { color: #D4993A; }
  .nav-fr { background: none; border: none; border-bottom: 1px solid #8C2D3F; padding-bottom: 2px; color: #F2E4C4; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; transition: color 0.2s; }
  .nav-fr:hover { color: #D4993A; }
  .scroll-layout { display: grid; grid-template-columns: 38% 62%; min-height: 100vh; padding-top: 132px; }
  .scroll-aside { position: sticky; top: 132px; height: calc(100vh - 132px); border-right: 1px solid rgba(212,153,58,0.25); overflow: hidden; }
  .aside-inner { height: 100%; padding: 3rem 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .aside-meta { display: flex; gap: 1.2rem; align-items: center; }
  .projet-cat { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.3em; text-transform: uppercase; color: #8C2D3F; border: 1px solid #8C2D3F; padding: 0.3rem 0.8rem; }
  .projet-annee { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.3em; color: rgba(255,255,255,0.25); }
  .aside-titre { font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 7vw, 8rem); line-height: 0.85; color: #F2E4C4; letter-spacing: 0.02em; }
  .aside-tagline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.5rem, 2.5vw, 3rem); -webkit-text-stroke: 1.5px #D4993A; color: transparent; letter-spacing: 0.05em; }
  .aside-brief { flex: 1; display: flex; flex-direction: column; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); }
  .aside-brief p { font-family: 'Space Grotesk', sans-serif; font-size: 0.82rem; line-height: 1.8; color: rgba(242,228,196,0.5); }
  .aside-infos { display: flex; flex-direction: column; gap: 1rem; }
  .aside-info-bloc { display: flex; flex-direction: column; gap: 0.3rem; }
  .aside-info-label { font-family: 'Space Mono', monospace; font-size: 0.48rem; letter-spacing: 0.3em; text-transform: uppercase; color: #8C2D3F; }
  .aside-info-val { font-family: 'Space Grotesk', sans-serif; font-size: 0.78rem; color: rgba(242,228,196,0.6); line-height: 1.5; }
  .aside-progress { position: relative; height: 16px; background: rgba(242,228,196,0.04); border: 1px solid rgba(212,174,88,0.18); overflow: hidden; margin-top: 0.4rem; }
  .aside-progress::before { content: 'VU'; position: absolute; top: -1.3rem; left: 0; font-family: 'Space Mono', monospace; font-size: 0.42rem; letter-spacing: 0.45em; color: rgba(212,174,88,0.45); }
  .aside-progress::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: repeating-linear-gradient(to right, transparent 0px, transparent 8px, rgba(14,9,6,0.85) 8px, rgba(14,9,6,0.85) 10px); }
  .progress-bar { height: 100%; width: 0%; background: linear-gradient(to right, #F2E4C4 0%, #D4993A 65%, #8C2D3F 100%); transition: width 0.1s linear; }
  .scroll-main { padding: 4rem 3rem 6rem; display: flex; flex-direction: column; gap: 6rem; }
  .visuel-block { position: relative; }
  .visuel-block::before { content: attr(data-label); position: absolute; top: -1.5rem; left: 0; font-family: 'Space Mono', monospace; font-size: 0.5rem; letter-spacing: 0.4em; color: #D4993A; }
  .visuel-block img { width: 100%; height: auto; display: block; }
  .reveal { opacity: 0; transform: translateY(50px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .projet-nav { display: flex; justify-content: space-between; position: fixed; top: 72px; left: 0; right: 0; z-index: 999; background: #8C2D3F; padding: 14px 2.5rem; }
  .projet-nav-retour, .projet-nav-suivant { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.9); transition: color 0.2s; }
  .projet-nav-retour:hover, .projet-nav-suivant:hover { color: #D4993A; }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; padding: 0.5rem; z-index: 200; }
  .nav-burger span { display: block; width: 24px; height: 2px; background: #fff; transition: all 0.3s; }
  .nav-burger.ouvert span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.ouvert span:nth-child(2) { opacity: 0; }
  .nav-burger.ouvert span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 768px) {
    .scroll-layout { grid-template-columns: 1fr; }
    .scroll-aside { position: static; height: auto; border-right: none; border-bottom: 1px solid rgba(212,153,58,0.25); }
    .aside-inner { padding: 2rem 1.2rem; }
    .scroll-main { padding: 2rem 1.2rem 4rem; gap: 3rem; }
    .aside-progress { display: none; }
    nav:not(.projet-nav) { padding: 1.2rem 1.5rem; background: #0E0906; }
    .nav-burger { display: flex; }
    nav ul { display: flex; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #0E0906; flex-direction: column; align-items: center; justify-content: center; gap: 3rem; z-index: 150; transform: translateX(100%); transition: transform 0.4s ease; }
    nav ul.ouvert { transform: translateX(0); }
    nav ul a { font-size: 1rem; letter-spacing: 0.3em; }
    .projet-nav { top: 72px; }
  }
</style>

<script is:inline>
  var translations = {
    fr: { 'nav.projects': 'Projets', 'nav.about': 'À propos', 'nav.contact': 'Contact', 'cat.campaign': 'Campagne 360', 'duralex.tagline': 'On fait tous pareil', 'duralex.desc': "Rachetée par ses salariés après liquidation judiciaire, Duralex renait en coopérative. Cette campagne mobilise le grand public pour soutenir ce modèle porté par les travailleurs eux-mêmes.", 'brief.goal': 'Objectif', 'brief.target': 'Cible', 'brief.supports': 'Supports', 'duralex.goal': 'Sensibiliser · Inciter aux dons pour la SCOP', 'duralex.target': 'Grand public · Consommateurs engagés · Nostalgiques', 'duralex.supports': 'Affichage · Réseaux sociaux' },
    en: { 'nav.projects': 'Projects', 'nav.about': 'About', 'nav.contact': 'Contact', 'cat.campaign': '360 Campaign', 'duralex.tagline': 'We all do the same', 'duralex.desc': 'Bought back by its employees after liquidation, Duralex was reborn as a cooperative. This campaign mobilises the public to support this worker-driven model.', 'brief.goal': 'Goal', 'brief.target': 'Target', 'brief.supports': 'Supports', 'duralex.goal': 'Raise awareness · Encourage donations for the cooperative', 'duralex.target': 'General public · Engaged consumers · Nostalgics', 'duralex.supports': 'Advertising · Social media' }
  };
  function applyLang(lang) { document.querySelectorAll('[data-i18n]').forEach(function(el) { var k = el.getAttribute('data-i18n'); if (translations[lang][k]) el.textContent = translations[lang][k]; }); var t = document.getElementById('langToggle'); if (t) t.textContent = lang === 'fr' ? 'EN' : 'FR'; localStorage.setItem('vaema-lang', lang); }
  var currentLang = localStorage.getItem('vaema-lang') || 'fr';
  if (currentLang === 'en') applyLang('en');
  var toggle = document.getElementById('langToggle');
  if (toggle) { toggle.textContent = currentLang === 'fr' ? 'EN' : 'FR'; toggle.addEventListener('click', function() { currentLang = currentLang === 'fr' ? 'en' : 'fr'; applyLang(currentLang); }); }
</script>
<script is:inline>
  var burger = document.getElementById('navBurger'); var menu = document.getElementById('navMenu');
  burger.addEventListener('click', function() { burger.classList.toggle('ouvert'); menu.classList.toggle('ouvert'); });
  menu.querySelectorAll('a').forEach(function(l) { l.addEventListener('click', function() { burger.classList.remove('ouvert'); menu.classList.remove('ouvert'); }); });
  var observer = new IntersectionObserver(function(entries) { entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); }); }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
  var progressBar = document.getElementById('progressBar'); var scrollMain = document.querySelector('.scroll-main');
  function updateProgress() { if (!progressBar || !scrollMain) return; var rect = scrollMain.getBoundingClientRect(); var pct = Math.max(0, Math.min(100, (-rect.top / (scrollMain.offsetHeight - window.innerHeight)) * 100)); progressBar.style.width = pct + '%'; }
  window.addEventListener('scroll', updateProgress, { passive: true }); updateProgress();
</script>

