---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <div id="splash">

    <video id="video" autoplay muted playsinline>
      <source src="/videos/video-entree.mp4" type="video/mp4" />
    </video>

    <div id="logo"><img src="/logo-vaema.svg" alt="VAEMA" /></div>

    <a id="btn-decouvrir" href="/home">DÉCOUVRIR</a>

  </div>

</Layout>

<style is:global>

  body {
    background: #000;
    margin: 0;
    padding: 0;
  }

  #splash {
    position: fixed;
    inset: 0;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  #video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }

  #logo {
    position: absolute;
    top: 2rem;
    left: 2.5rem;
    z-index: 2;
  }

  #logo img {
    height: 36px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  #btn-decouvrir {
    position: relative;
    z-index: 2;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #F2E4C4;
    border: 1px solid #8C2D3F;
    padding: 1.2rem 3.5rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.8s ease, transform 0.8s ease, background 0.5s, border-color 0.5s, color 0.3s;
  }

  #btn-decouvrir.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #btn-decouvrir.attirer {
    background: #8C2D3F;
    border-color: #D4993A;
    animation: pulseBouton 1.8s ease-in-out infinite;
  }

  @keyframes pulseBouton {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(212,153,58,0); }
    50%       { transform: scale(1.04); box-shadow: 0 0 18px 4px rgba(212,153,58,0.35); }
  }

  #btn-decouvrir:hover {
    background: #8C2D3F;
    border-color: #8C2D3F;
    color: #F2E4C4;
    animation: none;
  }

</style>

<script is:inline>
  var btn = document.getElementById('btn-decouvrir');

  // Bouton visible dès le début (fondu rapide)
  setTimeout(function() {
    btn.classList.add('visible');
  }, 400);

  // Après 5 secondes sans clic → animation pour attirer l'œil
  var timerAttirer = setTimeout(function() {
    btn.classList.add('attirer');
  }, 5000);

  // Si la personne clique → on arrête l'animation
  btn.addEventListener('click', function() {
    clearTimeout(timerAttirer);
    btn.classList.remove('attirer');
  });
</script>
