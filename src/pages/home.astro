---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- NAV -->
  <nav>
    <a href="/home" class="nav-logo"><img src="/logo-vaema.svg" alt="VAEMA" /></a>
    <button class="nav-burger" id="navBurger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <ul id="navMenu">
      <li><a href="#projets" data-i18n="nav.projects">Projets</a></li>
      <li><a href="#l-artiste" data-i18n="nav.about">À propos</a></li>
      <li><a href="#on-se-capte" data-i18n="nav.contact">Contact</a></li>
      <li><button id="langToggle" class="nav-fr">FR</button></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-placeholder"></div>
  </section>

  <!-- BANDEAU DÉFILANT -->
  <div class="bandeau">
    <div class="bandeau-track" id="bandeauTrack">
      <div class="bandeau-inner" id="bandeauContent">
        <span data-i18n="band.da">Direction Artistique</span><span class="sep"> ✦ </span><span data-i18n="band.design">Design Graphique</span><span class="sep"> ✦ </span><span data-i18n="band.print">Print & Digital</span><span class="sep"> ✦ </span><span data-i18n="band.identity">Identité Visuelle</span><span class="sep"> ✦ </span><span data-i18n="band.sign">Signalétique</span><span class="sep"> ✦ </span>
      </div>
    </div>
  </div>

  <!-- TITRE SECTION -->
  <div class="section-titre">
    <span class="section-label"><span data-i18n="section.my">MES</span> <span class="section-outline" data-i18n="section.work">CRÉAS</span></span>
    <div class="section-line"></div>
    <span class="section-num">05</span>
  </div>

  <!-- PROJETS -->
  <section class="projets" id="projets">

    <div class="grille-grandes">

      <a href="/portfolio/lego" class="carte">
        <img src="/projects/lego.JPG" alt="LEGO" />
        <div class="overlay">
          <span class="cat" data-i18n="cat.display">Affichage</span>
          <h3 class="titre">LEGO</h3>
          <span class="lien" data-i18n="see">Voir le projet →</span>
        </div>
      </a>

      <a href="/portfolio/sea-shepherd" class="carte carte-naturelle">
        <img src="/projects/seasheperd.JPG" alt="Sea Shepherd" />
        <div class="overlay">
          <span class="cat" data-i18n="cat.campaign">Campagne 360</span>
          <h3 class="titre">SEA SHEPHERD</h3>
          <span class="lien" data-i18n="see">Voir le projet →</span>
        </div>
      </a>

    </div>

    <div class="grille-petites">

      <a href="/portfolio/duralex" class="carte">
        <img src="/projects/duralex.PNG" alt="Duralex" />
        <div class="overlay">
          <span class="cat" data-i18n="cat.campaign">Campagne 360</span>
          <h3 class="titre">DURALEX</h3>
          <span class="lien" data-i18n="see">Voir le projet →</span>
        </div>
      </a>

      <a href="/portfolio/floyd" class="carte">
        <img src="/projects/floyd.png" alt="Floyd" />
        <div class="overlay">
          <span class="cat" data-i18n="cat.campaign">Campagne 360</span>
          <h3 class="titre">FLOYD</h3>
          <span class="lien" data-i18n="see">Voir le projet →</span>
        </div>
      </a>

      <a href="/portfolio/after-all-fest" class="carte">
        <img src="/projects/after-all-fest.JPG" alt="After All Fest" />
        <div class="overlay">
          <span class="cat" data-i18n="cat.identity">Identité Visuelle · Campagne 360</span>
          <h3 class="titre">AFTER ALL FEST</h3>
          <span class="lien" data-i18n="see">Voir le projet →</span>
        </div>
      </a>

      <a href="/portfolio/sos-villages-enfants" class="carte">
        <img src="/projects/sos.JPG" alt="SOS Villages d'Enfants" />
        <div class="overlay">
          <span class="cat" data-i18n="cat.campaign">Campagne 360</span>
          <h3 class="titre">SOS VILLAGES</h3>
          <span class="lien" data-i18n="see">Voir le projet →</span>
        </div>
      </a>

    </div>

  </section>

  <!-- À PROPOS + CONTACT -->
  <section class="apropos-contact">

    <div class="apropos" id="l-artiste">
      <div class="vinyle-wrap" aria-hidden="true">
        <img class="vinyle" src="/vinyle.png" alt="" />
      </div>
      <div class="apropos-titre">
        <span data-i18n="about.pre">L'</span><span class="section-outline" data-i18n="about.title">ARTISTE</span>
      </div>

      <div class="apropos-corps">
        <div class="apropos-photo-placeholder">
          <span>TA PHOTO ICI</span>
        </div>

        <div class="apropos-texte">
          <p data-i18n="about.p1">Directrice Artistique freelance en formation à SUP DE PUB Bordeaux, je navigue entre deux univers en apparence opposés : le brutalisme streetwear — brut, affirmé, sans compromis — et l'univers enfantin — coloré, poétique, plein de douceur.</p>
          <p data-i18n="about.p2">Cette dualité, c'est ma signature. Chaque projet est une nouvelle façon d'explorer ces deux territoires.</p>

          <div class="outils">
            <span class="outil-label" data-i18n="about.tools">Outils</span>
            <div class="outil-liste">
              <span>Illustrator</span>
              <span>Photoshop</span>
              <span>Première Pro</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="contact" id="on-se-capte">
      <div class="apropos-titre">
        <span data-i18n="contact.pre">ON SE </span><span class="section-outline" data-i18n="contact.title">CAPTE ?</span>
      </div>

      <div class="contact-corps">
        <a href="mailto:maeva.maecrea@gmail.com" class="contact-ligne">
          <span class="contact-label">Mail</span>
          <span class="contact-val">maeva.maecrea@gmail.com</span>
        </a>
        <a href="https://linkedin.com/in/maeva-petit" target="_blank" class="contact-ligne">
          <span class="contact-label">LinkedIn</span>
          <span class="contact-val">maeva petit →</span>
        </a>
        <a href="https://www.instagram.com/maecrea_/" target="_blank" class="contact-ligne">
          <span class="contact-label">Instagram</span>
          <span class="contact-val">@maecrea_ →</span>
        </a>
      </div>
    </div>

  </section>

  <!-- CURSEUR CUSTOM -->

  <!-- BOUTON RETOUR EN HAUT -->
  <button id="btn-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

</Layout>

<style is:global>

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .nav-logo img {
    height: 36px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  nav ul {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  nav ul a {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    transition: color 0.2s;
  }

  nav ul a:hover { color: #D4993A; }

  .nav-fr {
    background: none;
    border: none;
    border-bottom: 1px solid #8C2D3F;
    padding-bottom: 2px;
    color: #F2E4C4;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s;
  }
  .nav-fr:hover { color: #D4993A; }

  /* ── HERO ── */
  .hero {
    width: 100%;
    padding-top: 80px;
  }

  .hero-placeholder {
    width: 100%;
    height: calc(100vh - 80px - 48px);
    background: #1a1108;
    border-bottom: 1px solid rgba(212,153,58,0.15);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .hero-placeholder { height: 60vh; }
  }

  /* ── VINYLE ── */
  .vinyle-wrap {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 220px;
    height: 220px;
    opacity: 0.45;
    pointer-events: none;
    transition: opacity 0.5s ease;
    z-index: 0;
  }

  .apropos:hover .vinyle-wrap {
    opacity: 0.75;
  }

  .vinyle {
    width: 100%;
    height: 100%;
  }

  /* ── BANDEAU ── */
  .bandeau {
    overflow: hidden;
    padding: 0.9rem 0;
    background: #8C2D3F;
  }

  .bandeau-track {
    display: flex;
    will-change: transform;
  }

  .bandeau-inner {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .bandeau-inner span {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #D4993A;
    padding: 0 1.2rem;
  }

  .bandeau-inner .sep {
    color: #000;
    padding: 0;
  }

  @keyframes defiler {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }


  /* ── TITRE SECTION ── */
  .section-titre {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 2rem 2.5rem 0;
  }

  .section-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F2E4C4;
    white-space: nowrap;
  }

  .section-outline {
    -webkit-text-stroke: 1.5px #8C2D3F;
    color: transparent;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: #D4993A;
  }

  .section-num {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: #D4993A;
  }

  /* ── PROJETS ── */
  .projets {
    padding: 0.3rem 2.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .carte {
    display: block;
    position: relative;
    overflow: hidden;
    background: #111;
  }

  .carte img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .carte:hover img { transform: scale(1.04); }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .carte:hover .overlay { opacity: 1; }

  .cat {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #8C2D3F;
    margin-bottom: 0.4rem;
  }

  .titre {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    color: #F2E4C4;
    line-height: 1;
    margin-bottom: 0.8rem;
  }

  .lien {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #D4993A;
    border-bottom: 1px solid #D4993A;
    padding-bottom: 2px;
    width: fit-content;
  }

  .grille-grandes {
    display: flex;
    gap: 1rem;
    height: 70vh;
  }

  .grille-grandes .carte { flex: 1; height: 100%; }
  .grille-grandes .carte-naturelle { flex: none; width: auto; }
  .grille-grandes .carte-naturelle img { height: 100%; width: auto; object-fit: unset; display: block; }
  .grille-grandes .titre { font-size: 4rem; }

  .grille-petites {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .grille-petites .titre { font-size: 4rem; }

  /* ── CURSEUR ── */



  /* ── BOUTON TOP ── */
  #btn-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 100;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: #000;
    background: #D4993A;
    border: none;
    padding: 0.8rem 1.2rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  #btn-top:hover {
    background: #8C2D3F;
    color: #D4993A;
  }

  /* ── À PROPOS + CONTACT ── */
  .apropos-contact {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    border-top: 1px solid #D4993A;
    margin-top: 4rem;
  }

  .apropos {
    padding: 3rem 2.5rem;
    border-right: 1px solid #D4993A;
    position: relative;
    overflow: hidden;
  }

  .contact {
    padding: 3rem 2.5rem;
  }

  .apropos-titre {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem;
    letter-spacing: 0.1em;
    color: #F2E4C4;
    margin-bottom: 2rem;
  }

  .apropos-corps {
    display: flex;
    gap: 2rem;
  }

  .apropos-photo-placeholder {
    width: 160px;
    min-height: 200px;
    flex-shrink: 0;
    background: #141414;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: repeating-linear-gradient(
      -45deg, transparent, transparent 14px,
      rgba(255,45,135,0.04) 14px, rgba(255,45,135,0.04) 15px
    );
  }

  .apropos-photo-placeholder span {
    font-family: 'Space Mono', monospace;
    font-size: 0.45rem;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.15);
    border: 1px dashed rgba(255,255,255,0.1);
    padding: 0.5rem 0.8rem;
    text-align: center;
  }

  .apropos-texte {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .apropos-texte p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.55);
  }

  .outils {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .outil-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8C2D3F;
  }

  .outil-liste {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .outil-liste span {
    font-family: 'Space Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 0.3rem 0.8rem;
    transition: color 0.2s, border-color 0.2s;
    cursor: default;
  }

  .outil-liste span:hover {
    color: #D4993A;
    border-color: #D4993A;
  }

  .contact-corps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .contact-ligne {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #D4993A;
    transition: padding-left 0.3s;
  }

  .contact-ligne:hover { padding-left: 0.5rem; }
  .contact-ligne:hover .contact-val { color: #D4993A; }

  .contact-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8C2D3F;
  }

  .contact-val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    color: #F2E4C4;
  }

  /* ── HAMBURGER ── */
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    z-index: 200;
  }
  .nav-burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #F2E4C4;
    transition: all 0.3s;
  }
  .nav-burger.ouvert span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.ouvert span:nth-child(2) { opacity: 0; }
  .nav-burger.ouvert span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── MOBILE ── */
  @media (max-width: 768px) {


    nav { padding: 1.2rem 1.5rem; backdrop-filter: none; background: #0E0906; }

    .nav-burger { display: flex; }

    nav ul {
      display: flex;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: #0E0906;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      z-index: 150;
      transform: translateX(100%);
      transition: transform 0.4s ease;
    }
    nav ul.ouvert { transform: translateX(0); }
    nav ul a { font-size: 1rem; letter-spacing: 0.3em; }

    .section-titre { padding: 1.5rem 1.2rem 0; }
    .section-label { font-size: 2rem; }

    .projets { padding: 0.3rem 1.2rem 3rem; }

    .grille-grandes {
      flex-direction: column;
      height: auto;
    }
    .grille-grandes .carte { height: 50vw; }
    .grille-grandes .carte-naturelle { width: 100%; }
    .grille-grandes .carte-naturelle img { width: 100%; height: 50vw; object-fit: cover; }
    .grille-grandes .titre { font-size: 2.5rem; }

    .grille-petites {
      grid-template-columns: repeat(2, 1fr);
    }
    .grille-petites .titre { font-size: 2rem; }

    .apropos-contact {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
    .apropos { border-right: none; border-bottom: 1px solid #D4993A; padding: 2rem 1.2rem; }
    .contact { padding: 2rem 1.2rem; }
    .apropos-titre { font-size: 2.2rem; }

    .apropos-corps { flex-direction: column; }
    .apropos-photo-placeholder { width: 100%; min-height: 200px; }

    #btn-top { bottom: 1rem; right: 1rem; }
  }

</style>

<script is:inline>
  // ── TRADUCTIONS ──
  var translations = {
    fr: {
      'nav.projects': 'Projets',
      'nav.about': 'À propos',
      'nav.contact': 'Contact',
      'band.da': 'Direction Artistique',
      'band.design': 'Design Graphique',
      'band.print': 'Print & Digital',
      'band.identity': 'Identité Visuelle',
      'band.sign': 'Signalétique',
      'section.my': 'MES',
      'section.work': 'CRÉAS',
      'cat.display': 'Affichage',
      'cat.campaign': 'Campagne 360',
      'cat.identity': 'Identité Visuelle · Campagne 360',
      'see': 'Voir le projet →',
      'about.pre': "L'",
      'about.title': 'ARTISTE',
      'about.p1': "Directrice Artistique freelance en formation à SUP DE PUB Bordeaux, je navigue entre deux univers en apparence opposés : le brutalisme streetwear — brut, affirmé, sans compromis — et l'univers enfantin — coloré, poétique, plein de douceur.",
      'about.p2': "Cette dualité, c'est ma signature. Chaque projet est une nouvelle façon d'explorer ces deux territoires.",
      'about.tools': 'Outils',
      'contact.pre': 'ON SE ',
      'contact.title': 'CAPTE ?'
    },
    en: {
      'nav.projects': 'Projects',
      'nav.about': 'About',
      'nav.contact': 'Contact',
      'band.da': 'Art Direction',
      'band.design': 'Graphic Design',
      'band.print': 'Print & Digital',
      'band.identity': 'Visual Identity',
      'band.sign': 'Signage',
      'section.my': 'MY',
      'section.work': 'WORK',
      'cat.display': 'Advertising',
      'cat.campaign': '360 Campaign',
      'cat.identity': 'Visual Identity · 360 Campaign',
      'see': 'See project →',
      'about.pre': 'THE ',
      'about.title': 'ARTIST',
      'about.p1': 'Freelance Art Director in training at SUP DE PUB Bordeaux, I navigate between two seemingly opposite worlds: streetwear brutalism — raw, bold, uncompromising — and the world of childhood — colorful, poetic, full of softness.',
      'about.p2': 'This duality is my signature. Every project is a new way to explore these two territories.',
      'about.tools': 'Tools',
      'contact.pre': "LET'S ",
      'contact.title': 'CONNECT?'
    }
  };

  function applyLang(lang) {
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n');
      if (translations[lang][key]) el.textContent = translations[lang][key];
    });
    var toggle = document.getElementById('langToggle');
    if (toggle) toggle.textContent = lang === 'fr' ? 'EN' : 'FR';
    localStorage.setItem('vaema-lang', lang);
  }

  var currentLang = localStorage.getItem('vaema-lang') || 'fr';
  if (currentLang === 'en') applyLang('en');

  var toggle = document.getElementById('langToggle');
  if (toggle) {
    toggle.textContent = currentLang === 'fr' ? 'EN' : 'FR';
    toggle.addEventListener('click', function() {
      currentLang = currentLang === 'fr' ? 'en' : 'fr';
      applyLang(currentLang);
    });
  }
</script>

<script is:inline>
  // Hamburger menu
  var burger = document.getElementById('navBurger');
  var menu = document.getElementById('navMenu');
  burger.addEventListener('click', function() {
    burger.classList.toggle('ouvert');
    menu.classList.toggle('ouvert');
  });
  menu.querySelectorAll('a').forEach(function(lien) {
    lien.addEventListener('click', function() {
      burger.classList.remove('ouvert');
      menu.classList.remove('ouvert');
    });
  });

  // Curseur custom
  var ciblesViolet = document.querySelectorAll('nav, .section-outline, .section-num, .cat, .outil-label, .contact-label, #btn-top, .bandeau');
  ciblesViolet.forEach(function(el) {
    el.addEventListener('mouseenter', function() { curseur.classList.add('jaune'); });
    el.addEventListener('mouseleave', function() { curseur.classList.remove('jaune'); });
  });

  // Vinyle rotation
  window.addEventListener('DOMContentLoaded', function() {
    var vinyle = document.querySelector('.vinyle');
    var aproposSection = document.getElementById('l-artiste');
    if (!vinyle || !aproposSection) return;

    var angle = 0;
    var vitesse = 0.28;
    var vitesseCible = 0.28;
    var surVinyle = false;

    aproposSection.addEventListener('mouseenter', function() { surVinyle = true; });
    aproposSection.addEventListener('mouseleave', function() { surVinyle = false; });

    function tournerVinyle() {
      vitesseCible = surVinyle ? 0.45 : 0.06;
      vitesse += (vitesseCible - vitesse) * 0.04;
      angle += vitesse;
      vinyle.style.transform = 'rotate(' + angle + 'deg)';
      requestAnimationFrame(tournerVinyle);
    }
    tournerVinyle();
  });

  var content = document.getElementById('bandeauContent');
  var track   = document.getElementById('bandeauTrack');
  if (content && track) {
    track.appendChild(content.cloneNode(true));
    track.appendChild(content.cloneNode(true));
    track.appendChild(content.cloneNode(true));
    var w = content.getBoundingClientRect().width;
    var x = 0;
    function loop() {
      x -= 0.8;
      if (x <= -w) x += w;
      track.style.transform = 'translateX(' + x + 'px)';
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  }
</script>
