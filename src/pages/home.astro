---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- NAV -->
  <nav>
    <a href="/home" class="nav-logo"><img src="/logo-vaema.svg" alt="VAEMA" /></a>
    <button class="nav-burger" id="navBurger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <ul id="navMenu">
      <li><a href="#projets" data-i18n="nav.projects">Tracklist</a></li>
      <li><a href="#l-artiste" data-i18n="nav.about">Crédits</a></li>
      <li><a href="#on-se-capte" data-i18n="nav.contact">Booking</a></li>
      <li><button id="langToggle" class="nav-fr">FR</button></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-placeholder">
      <img src="/photo-maeva-rogne.jpg" alt="Maëva PETIT" class="hero-photo" />
      <div class="hero-fondu"></div>
      <div class="hero-nom">
        <span class="hero-prenom">Maëva</span>
        <span class="hero-nom-famille">PETIT</span>
      </div>
    </div>
  </section>

  <!-- BANDEAU DÉFILANT -->
  <div class="bandeau">
    <div class="bandeau-track" id="bandeauTrack">
      <div class="bandeau-inner" id="bandeauContent">
        <span data-i18n="band.da">Direction Artistique</span><span class="sep"> ●</span><span data-i18n="band.design">Design Graphique</span><span class="sep"> ●</span><span data-i18n="band.print">Print & Digital</span><span class="sep"> ●</span><span data-i18n="band.identity">Identité Visuelle</span><span class="sep"> ●</span><span data-i18n="band.sign">Signalétique</span><span class="sep"> ●</span>
      </div>
    </div>
  </div>

  <!-- TITRE SECTION -->
  <div class="section-titre">
    <span class="section-label"><span data-i18n="section.my">MA</span> <span class="section-outline" data-i18n="section.work">TRACKLIST</span></span>
    <div class="section-line"></div>
    <span class="section-num">07</span>
  </div>

  <!-- DISCOGRAPHIE -->
  <section class="discographie" id="projets">

    <div class="disco-ligne disco-ligne--grande">

      <div class="carte-wrap carte-wrap--sm">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">FLOYD</span>
            <span class="etiquette-cat" data-i18n="cat.campaign">Campagne 360</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/floyd" class="carte">
          <div class="carte-image">
            <img src="/projects/floyd.png" alt="Floyd" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 01</span>
            <h3 class="track-titre">FLOYD</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.campaign">Campagne 360</span>
              <span class="track-annee">2025</span>
            </div>
          </div>
        </a>
      </div>

      <div class="carte-wrap carte-wrap--sm">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">AFTER ALL FEST</span>
            <span class="etiquette-cat" data-i18n="cat.identity">Identité · Campagne</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/after-all-fest" class="carte">
          <div class="carte-image">
            <img src="/projects/after-all-fest.JPG" alt="After All Fest" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 02</span>
            <h3 class="track-titre">AFTER ALL FEST</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.identity">Identité · Campagne</span>
              <span class="track-annee">2026</span>
            </div>
          </div>
        </a>
      </div>

      <div class="carte-wrap">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">LEGO</span>
            <span class="etiquette-cat" data-i18n="cat.display">Affichage</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/lego" class="carte">
          <div class="carte-image">
            <img src="/projects/lego.JPG" alt="LEGO" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 03</span>
            <h3 class="track-titre">LEGO</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.display">Affichage</span>
              <span class="track-annee">2026</span>
            </div>
          </div>
        </a>
      </div>

    </div>

    <div class="disco-ligne disco-ligne--petite">

      <div class="carte-wrap">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">NIKE</span>
            <span class="etiquette-cat" data-i18n="cat.display">Affichage</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/nike" class="carte">
          <div class="carte-image">
            <img src="/projects/nike/panier-basket.jpg" alt="Nike" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 04</span>
            <h3 class="track-titre">NIKE</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.display">Affichage</span>
              <span class="track-annee">2026</span>
            </div>
          </div>
        </a>
      </div>

      <div class="carte-wrap">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">SEA SHEPHERD</span>
            <span class="etiquette-cat" data-i18n="cat.campaign">Campagne 360</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/sea-shepherd" class="carte">
          <div class="carte-image">
            <img src="/projects/seasheperd.JPG" alt="Sea Shepherd" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 05</span>
            <h3 class="track-titre">SEA SHEPHERD</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.campaign">Campagne 360</span>
              <span class="track-annee">2026</span>
            </div>
          </div>
        </a>
      </div>

      <div class="carte-wrap">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">DURALEX</span>
            <span class="etiquette-cat" data-i18n="cat.campaign">Campagne 360</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/duralex" class="carte">
          <div class="carte-image">
            <img src="/projects/duralex.PNG" alt="Duralex" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 06</span>
            <h3 class="track-titre">DURALEX</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.campaign">Campagne 360</span>
              <span class="track-annee">2026</span>
            </div>
          </div>
        </a>
      </div>

      <div class="carte-wrap">
        <div class="carte-etiquette">
          <div class="etiquette-gauche">
            <span class="etiquette-titre">SOS VILLAGES</span>
            <span class="etiquette-cat" data-i18n="cat.campaign">Campagne 360</span>
          </div>
          <span class="etiquette-lien" data-i18n="see">▶ Play</span>
        </div>
        <a href="/portfolio/sos-villages-enfants" class="carte">
          <div class="carte-image">
            <img src="/projects/sos.JPG" alt="SOS Villages d'Enfants" />
            <div class="reflet"></div>
          </div>
          <div class="cartouche">
            <span class="track-num">TRACK 07</span>
            <h3 class="track-titre">SOS VILLAGES</h3>
            <div class="track-barre"></div>
            <div class="track-meta">
              <span class="track-cat" data-i18n="cat.campaign">Campagne 360</span>
              <span class="track-annee">2026</span>
            </div>
          </div>
        </a>
      </div>

    </div>

  </section>

  <!-- À PROPOS + CONTACT -->
  <section class="apropos-contact">

    <div class="apropos" id="l-artiste">

      <!-- Disque vinyle décoratif -->
      <div class="vinyle-wrap">
        <svg class="vinyle" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <circle cx="100" cy="100" r="98" fill="#0E0906" stroke="#D4993A" stroke-width="0.5"/>
          <circle cx="100" cy="100" r="82" fill="none" stroke="#1a1108" stroke-width="1"/>
          <circle cx="100" cy="100" r="70" fill="none" stroke="#1a1108" stroke-width="0.5"/>
          <circle cx="100" cy="100" r="58" fill="none" stroke="#1a1108" stroke-width="1"/>
          <circle cx="100" cy="100" r="46" fill="none" stroke="#1a1108" stroke-width="0.5"/>
          <circle cx="100" cy="100" r="34" fill="none" stroke="#1a1108" stroke-width="1"/>
          <circle cx="100" cy="100" r="24" fill="#D4993A"/>
          <circle cx="100" cy="100" r="8" fill="#0E0906"/>
        </svg>
      </div>

      <div class="apropos-titre">
        <span data-i18n="about.pre">L'</span><span class="section-outline" data-i18n="about.title">ARTISTE</span>
      </div>

      <div class="sleeve-corps">

        <!-- Photo façon "band photo" -->
        <div class="sleeve-photo">
          <img src="/maeva.jpg" alt="Maëva PETIT" class="apropos-photo" />
          <p class="sleeve-photo-legende" data-i18n="about.photo">Maëva PETIT — Bordeaux, 2026</p>
        </div>

        <!-- Notes d'album -->
        <div class="sleeve-notes">
          <h2 class="sleeve-titre" data-i18n="about.title">MAËVA PETIT</h2>

          <div class="sleeve-bio">
            <p data-i18n="about.p1">Tout a commencé sur un projet de bachelor où j'ai pris en charge la direction artistique et je n'ai plus voulu lâcher. C'est là que j'ai compris que c'était ça, mon truc : partir d'une idée et la pousser jusqu'à ce qu'elle devienne quelque chose de fort.</p>
            <p data-i18n="about.p2">Ce que j'aime par-dessus tout, c'est l'idéation et la créa, ce moment où rien n'existe encore et où tout est possible. Mon objectif : travailler dans la musique, parce que c'est l'univers qui me touche le plus. En dehors des projets, je dessine, une autre façon de voir et de construire des images.</p>
          </div>

          <div class="sleeve-credits">
            <div class="sleeve-credit-ligne">
              <span class="sleeve-credit-label" data-i18n="about.recorded">Enregistré avec</span>
              <span class="sleeve-credit-val">Illustrator · Photoshop · CapCut</span>
            </div>
            <div class="sleeve-credit-ligne">
              <span class="sleeve-credit-label" data-i18n="about.assisted">Assisté par</span>
              <span class="sleeve-credit-val">Claude.IA · ChatGPT · NotebookLM · Gemini</span>
            </div>
            <div class="sleeve-credit-ligne">
              <span class="sleeve-credit-label" data-i18n="about.produced">Formation</span>
              <span class="sleeve-credit-val">SUP DE PUB Bordeaux — 2025/2027</span>
            </div>
          </div>

          <p class="sleeve-copyright">℗ & © 2026 MAEVA — Tous droits réservés.<br/>Toute reproduction interdite sans autorisation écrite.</p>
        </div>

      </div>
    </div>

    <div class="contact" id="on-se-capte">
      <div class="apropos-titre">
        <span data-i18n="contact.pre">ON SE </span><span class="section-outline" data-i18n="contact.title">BOOK ?</span>
      </div>

      <div class="contact-corps">
        <a href="mailto:maeva.maecrea@gmail.com" class="contact-ligne">
          <span class="contact-label">Mail</span>
          <span class="contact-val">maeva.maecrea@gmail.com</span>
        </a>
        <a href="https://linkedin.com/in/maeva-petit" target="_blank" class="contact-ligne">
          <span class="contact-label">LinkedIn</span>
          <span class="contact-val">maeva petit →</span>
        </a>
        <a href="https://www.instagram.com/maecrea_/" target="_blank" class="contact-ligne">
          <span class="contact-label">Instagram</span>
          <span class="contact-val">@maecrea_ →</span>
        </a>
      </div>
    </div>

  </section>

  <!-- CURSEUR CUSTOM -->

  <!-- BOUTON RETOUR EN HAUT -->
  <button id="btn-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

  <!-- CONSOLE FOOTER -->
  <footer class="console">

    <!-- Afficheur LCD -->
    <div class="console-display">
      <span class="console-display-text" id="consoleDisplay">MAEVA PETIT — FACE B — VOL. I — 2026</span>
    </div>

    <!-- VU mètre décoratif gauche -->
    <div class="console-vu">
      <span class="console-vu-label">L</span>
      <div class="console-vu-bar">
        <div class="console-vu-fill" id="vuLeft"></div>
      </div>
      <span class="console-vu-label">R</span>
      <div class="console-vu-bar">
        <div class="console-vu-fill" id="vuRight"></div>
      </div>
    </div>

    <!-- Boutons transport -->
    <div class="console-transport">
      <button class="console-btn" data-label="REW">⏮</button>
      <button class="console-btn console-btn--play" data-label="PLAY">▶</button>
      <button class="console-btn" data-label="PAUSE">⏸</button>
      <button class="console-btn" data-label="STOP">■</button>
      <button class="console-btn" data-label="NEXT">⏭</button>
    </div>

    <!-- Label SIDE B -->
    <div class="console-side">
      <span class="console-side-dot"></span>
      <span class="console-side-label">SIDE B</span>
    </div>

  </footer>

</Layout>

<style is:global>

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .nav-logo img {
    height: 36px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  nav ul {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  nav ul a {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    transition: color 0.2s;
  }

  nav ul a:hover { color: #D4993A; }

  .nav-fr {
    background: none;
    border: none;
    border-bottom: 1px solid #8C2D3F;
    padding-bottom: 2px;
    color: #F2E4C4;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s;
  }
  .nav-fr:hover { color: #D4993A; }

  /* ── HERO ── */
  .hero {
    width: 100%;
    padding-top: 80px;
  }

  .hero-placeholder {
    width: 100%;
    height: calc(100vh - 80px - 48px);
    background: #0E0906;
    border-bottom: 1px solid rgba(212,153,58,0.15);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    right: 0;
    top: 0;
    width: auto;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    opacity: 0.85;
  }

  .hero-fondu {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, #0E0906 25%, rgba(14,9,6,0.6) 55%, transparent 80%);
    pointer-events: none;
  }

  .hero-nom {
    position: absolute;
    left: 3rem;
    bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    line-height: 0.9;
  }

  .hero-badge {
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: rgba(242,228,196,0.75);
    margin-top: 1.5rem;
    margin-left: 8.1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation: pulseText 1.5s ease-in-out infinite;
  }

  @keyframes pulseText {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }

  .hero-badge-dot {
    color: #D4993A;
    animation: pulseLED 1.5s ease-in-out infinite;
  }

  .hero-prenom {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(6rem, 15vw, 14rem);
    letter-spacing: 0.04em;
    color: #F2E4C4;
    line-height: 1;
  }

  .hero-nom-famille {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(6rem, 15vw, 14rem);
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 2px #F2E4C4;
    line-height: 1;
    transform: rotate(180deg);
    margin-top: -5.5rem;
    align-self: flex-start;
    margin-left: 8.1rem;
  }

  @media (max-width: 768px) {
    .hero-placeholder { height: 60vh; }
    .hero-fondu {
      background: radial-gradient(ellipse at top left, rgba(14,9,6,1) 0%, rgba(14,9,6,0.4) 40%, transparent 70%);
    }
    .hero-nom {
      top: 1.2rem;
      bottom: auto;
      left: 1.2rem;
      background: none;
      padding: 0;
    }
    .hero-prenom {
      font-size: 3.5rem;
    }
    .hero-nom-famille {
      font-size: 3.5rem;
      margin-top: -1.2rem;
      margin-left: 1.5rem;
    }
  }

  /* ── VINYLE ── */
  .vinyle-wrap {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 220px;
    height: 220px;
    opacity: 0.45;
    pointer-events: none;
    transition: opacity 0.5s ease;
    z-index: 0;
  }

  .apropos:hover .vinyle-wrap {
    opacity: 0.75;
  }

  .vinyle {
    width: 100%;
    height: 100%;
  }

  /* ── BANDEAU ── */
  .bandeau {
    overflow: hidden;
    padding: 0.9rem 0;
    background: #8C2D3F;
  }

  .bandeau-track {
    display: flex;
    will-change: transform;
  }

  .bandeau-inner {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .bandeau-inner span {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #D4993A;
    padding: 0 1.2rem;
  }

  .bandeau-inner .sep {
    color: #000;
    padding: 0;
  }

  @keyframes defiler {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }


  /* ── TITRE SECTION ── */
  .section-titre {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 2rem 2.5rem 0;
  }

  .section-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F2E4C4;
    white-space: nowrap;
  }

  .section-outline {
    -webkit-text-stroke: 1.5px #8C2D3F;
    color: transparent;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: #D4993A;
  }

  .section-num {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: #D4993A;
  }

  /* ── DISCOGRAPHIE ── */
  .discographie {
    padding: 80px 2.5rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  .disco-ligne {
    display: flex;
    gap: 1.5rem;
    overflow: visible;
  }

  .disco-ligne--grande { height: 62vh; }
  .disco-ligne--grande .carte-wrap { height: 100%; }

  .disco-ligne--petite {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .disco-ligne--petite .carte-wrap { aspect-ratio: 297 / 420; }

  /* ── WRAP ── */
  .carte-wrap {
    position: relative;
    flex: 1;
    overflow: visible;
  }

  /* Cartes portrait A3 (297×420mm) sur la première ligne */
  .carte-wrap--sm {
    flex: none;
    width: calc(62vh * 297 / 420);
  }

  /* ── CARTE (image pure, rien d'autre visible au repos) ── */
  .carte {
    display: block;
    position: relative;
    overflow: hidden;
    background: #0E0906;
    border-radius: 0;
    border: 1px solid rgba(212,174,88,0.08);
    width: 100%;
    height: 100%;
    z-index: 2;
    transition: transform 450ms cubic-bezier(.22,.61,.36,1),
                border-color 450ms cubic-bezier(.22,.61,.36,1);
  }

  .carte-wrap:hover .carte {
    transform: translateY(-8px) scale(1.01);
    border-color: #D4993A;
  }

  /* Texture papier */
  .carte::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
